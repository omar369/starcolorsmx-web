---
import AuthForm from "../components/auth/AuthForm.svelte";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Registro e inicio de sesión para el hub de herramientas StarColors."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inscríbete | StarColors</title>
  </head>
  <body class="min-h-screen bg-[#DBD3C6] font-sans antialiased text-[#111111] overflow-x-hidden">
    <main class="relative flex min-h-screen flex-col md:flex-row">
      <!-- Sección Izquierda: Branding Naranja -->
      <div class="relative flex w-full flex-col bg-[#e67a25] px-8 py-16 md:w-5/12 lg:w-1/3 text-white overflow-hidden justify-center items-start md:px-12 lg:px-16 shadow-[20px_0_40px_rgba(0,0,0,0.15)] z-10">
        
        <!-- Botón volver atrás -->
        <a class="absolute top-8 left-8 md:top-10 md:left-10 inline-flex items-center gap-2 rounded-full border-2 border-white/40 px-5 py-2 text-[0.85rem] font-bold tracking-wide text-white transition hover:bg-white/20 hover:border-white/60 z-20" href="/">
          <span aria-hidden="true">&larr;</span>
          Inicio
        </a>

        <div class="relative z-10 w-full max-w-sm mt-16 md:mt-0">
          <p class="mb-3 text-[0.8rem] font-black uppercase tracking-[0.15em] text-white/80">
            Clientes StarColors
          </p>
          <h1 class="mb-6 font-serif text-5xl md:text-6xl lg:text-7xl font-bold leading-[0.92] drop-shadow-sm">
            Acceso a<br/>herramientas
          </h1>
          <p class="text-[0.95rem] font-medium text-white/90 leading-relaxed max-w-[34rem]">
            Entra a tu cuenta para consultar tus registros, participar en dinámicas activas y usar las herramientas disponibles.
          </p>
        </div>
        
        <!-- Elemento decorativo inferior (opcional para mantener estilo navbar) -->
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
      </div>

      <!-- Sección Derecha: Formulario -->
      <div class="flex w-full flex-1 items-center justify-center p-6 sm:p-12 md:p-16 relative">
        <AuthForm client:load />
      </div>
    </main>
  </body>
</html>
