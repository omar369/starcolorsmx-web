---
import BaseLayout from "../layouts/BaseLayout.astro";
import MainBanner from "$lib/components/MainBanner.svelte";
import LandingCarousel from "$lib/components/LandingCarousel.svelte";
---

<BaseLayout
  title="StarColors | Sorteo de temporada"
  description="Participa en el sorteo de StarColors registrando tus boletos en el portal de clientes."
>
  <MainBanner client:load />
  <LandingCarousel client:load />
</BaseLayout>

<style is:global>
  body {
    background-color: #F3EADB !important;
  }
</style>
