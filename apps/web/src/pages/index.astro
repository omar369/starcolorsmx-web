---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="StarColors | Sorteo de temporada"
  description="Participa en el sorteo de StarColors registrando tus boletos en el portal de clientes."
>
  <section class="hero">
    <p class="eyebrow">Sorteo de temporada</p>

    <h1>Llévate una pantalla de 49&quot;</h1>

    <p class="hero-offer">
      Comprando un monto superior a los <strong>$250</strong>.
    </p>

    <div class="raffle-details">
      <p>
        Por cada 250 pesos de compra llévate un boleto para participar. Para
        registrar el boleto entra al portal de clientes y elige tu número de la
        suerte.
      </p>

      <p>
        Nosotros solo te pediremos tu nombre y correo electrónico para avisarte
        cuando puedas pasar por tu premio.
      </p>
    </div>

    <div class="hero-actions" aria-label="Acceso al sorteo">
      <p class="luck-note">MUCHA SUERTE</p>
      <a class="button-primary" href="/hub">¡Entra al sorteo!</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 1rem;
    padding-block: 3rem;
  }

  .eyebrow {
    margin: 0;
    color: #64748b;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
  }

  h1 {
    margin: 0;
    max-width: 780px;
    font-size: clamp(2.35rem, 11vw, 5rem);
    line-height: 0.95;
  }

  .hero-offer {
    margin: 0;
    max-width: 620px;
    color: #172033;
    font-size: clamp(1.15rem, 5vw, 1.8rem);
    font-weight: 760;
    line-height: 1.2;
  }

  .hero-offer strong {
    font-weight: 900;
  }

  .raffle-details {
    display: grid;
    gap: 0.75rem;
    max-width: 680px;
    color: #475569;
    font-size: 1rem;
    line-height: 1.7;
  }

  .raffle-details p {
    margin: 0;
  }

  .hero-actions {
    display: grid;
    gap: 0.65rem;
    align-items: center;
    justify-items: start;
    margin-top: 0.5rem;
  }

  .luck-note {
    margin: 0;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .luck-note::after {
    content: " ↓";
  }

  .button-primary {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 46px;
    padding: 0.78rem 1.15rem;
    border-radius: 999px;
    background: #172033;
    color: white;
    font-weight: 850;
  }

  @media (min-width: 680px) {
    .hero {
      padding-block: 4rem;
    }

    .hero-actions {
      grid-template-columns: auto auto;
      gap: 1rem;
    }

    .luck-note {
      order: 1;
    }

    .luck-note::after {
      content: " -->";
    }

    .button-primary {
      order: 2;
    }
  }
</style>
