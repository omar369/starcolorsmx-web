---
import Navbar from "$lib/components/Navbar.svelte";
import "../styles/global.css";

const {
  title = "Pinturas StarColors",
  description = "Pinturas, servicios y herramientas para clientes StarColors.",
  showNavbar = true,
  pageClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body>
    {showNavbar && <Navbar client:load />}

    <main class:list={["min-h-screen", pageClass]}>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: #172033;
    background: #f8fafc;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: #f8fafc;
  }

  img,
  svg,
  video {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }
</style>
