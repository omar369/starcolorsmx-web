---
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";

const {
  title = "Pinturas StarColors",
  description = "Cotización rápida para servicios de pintura residencial.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
  </head>
  <body>
  <Header />

    <main class="page">
      <slot />
    </main>

    <Footer /> 
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: #172033;
    background: #f8fafc;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .page {
    width: min(100% - 2rem, 1120px);
    margin-inline: auto;
    padding-block: 2rem 4rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    background: rgba(248, 250, 252, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #e2e8f0;
  }

  .brand {
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.9rem;
  }

  .nav a {
    color: #475569;
  }

  .nav a:hover {
    color: #0f172a;
  }

  .nav-cta {
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: #172033;
    color: white !important;
    font-weight: 700;
  }

  .site-footer {
    border-top: 1px solid #e2e8f0;
    padding: 1.5rem 1rem;
    color: #64748b;
    font-size: 0.875rem;
    text-align: center;
  }

  @media (max-width: 720px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .nav {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.25rem;
    }
  }
</style>
