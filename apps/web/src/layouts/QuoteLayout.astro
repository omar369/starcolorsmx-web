---
import "../styles/global.css";

const {
  title = "Cotizador | StarColors",
  description = "Cotizador automatico para servicios de pintura residencial.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
  </head>
  <body>
    <main class="quote-app-shell">
      <a class="exit-link" href="/" aria-label="Salir del cotizador">
        <span aria-hidden="true">←</span>
        Salir
      </a>

      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: #172033;
    background: #172033;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  body {
    min-height: 100dvh;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .quote-app-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    padding: clamp(0.75rem, 2vw, 1.25rem);
    background:
      radial-gradient(circle at top left, rgba(245, 183, 0, 0.2), transparent 34rem),
      linear-gradient(145deg, #111827 0%, #172033 52%, #243047 100%);
  }

  .exit-link {
    position: fixed;
    top: clamp(0.75rem, 2vw, 1.25rem);
    left: clamp(0.75rem, 2vw, 1.25rem);
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: #f8fafc;
    padding: 0.55rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 800;
    backdrop-filter: blur(12px);
  }

  .exit-link:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  @media (max-width: 540px) {
    .quote-app-shell {
      padding: 0.5rem;
      padding-top: 3.7rem;
    }
  }
</style>
