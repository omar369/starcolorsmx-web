---
import "../styles/global.css";

const {
  title = "Cotizador | StarColors",
  description = "Cotizador automatico para servicios de pintura residencial.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
  </head>
  <body>
    <main class="quote-app-shell">
      <a class="exit-link" href="/" aria-label="Salir del cotizador">
        <span aria-hidden="true">←</span>
        Salir
      </a>

      <slot />
    </main>
  </body>
</html>

<style is:global>
  /*
   * Estilos del shell del cotizador.
   * Usan :where() en algunos lugares para menor especificidad intencionada,
   * pero los valores críticos de layout usan selectores normales para que
   * ganen contra el preflight de Tailwind.
   */

  html:has(.quote-app-shell),
  body:has(.quote-app-shell) {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    /* No overflow:hidden — causa que en iOS el teclado rompa el layout */
    overflow: hidden;
  }

  .quote-app-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    /* dvh: evita el salto cuando aparece el teclado virtual en móvil */
    min-height: 100dvh;
    height: 100dvh;
    overflow: hidden;
    padding: clamp(0.75rem, 2vw, 1.25rem);
    background:
      radial-gradient(circle at top left, rgba(245, 183, 0, 0.2), transparent 34rem),
      linear-gradient(145deg, #111827 0%, #172033 52%, #243047 100%);
    /* La fuente la provee quotes.css para no depender del @theme de Tailwind */
  }

  /* El botón de salir necesita resets explícitos porque Tailwind borra border/bg */
  .exit-link {
    position: fixed;
    top: clamp(0.75rem, 2vw, 1.25rem);
    left: clamp(0.75rem, 2vw, 1.25rem);
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 40px;
    /* Explícitos — no hereda del reset */
    border: 1px solid rgba(255, 255, 255, 0.18) !important;
    border-radius: 999px !important;
    background: rgba(255, 255, 255, 0.1) !important;
    color: #f8fafc !important;
    padding: 0.55rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: pointer;
    transition: background 0.14s ease;
  }

  .exit-link:hover {
    background: rgba(255, 255, 255, 0.16) !important;
  }

  @media (max-width: 540px) {
    .quote-app-shell {
      padding: 0.5rem;
      padding-top: 3.7rem;
    }
  }
</style>
